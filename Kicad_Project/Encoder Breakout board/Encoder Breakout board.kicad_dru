(version 1)

(rule "ELC SHOP: Oblong drill holes must be larger than 1mm"
  (constraint assertion "(A.Hole_Size_X >= 1mm && A.Hole_Size_Y >= 1mm)")
  (condition "(A.Type == 'Pad' || A.Type == 'Via') && (A.Hole_Size_X > A.Hole_Size_Y || A.Hole_Size_Y > A.Hole_Size_X)")
  (severity error)
)

(rule "ELC SHOP: Minimum hole size is 0.4mm"
  (constraint hole_size (min 0.4mm))
  (severity error)
)

(rule "ELC SHOP: Drill holes smaller than 1mm must be whole tenth's i.e. 0.8mm NOT 0.83mm"
  (constraint assertion "(A.Hole_Size_X - 0.4mm == 0mm || A.Hole_Size_X - 0.5mm == 0mm || A.Hole_Size_X - 0.6mm == 0mm || A.Hole_Size_X - 0.7mm == 0mm || A.Hole_Size_X - 0.8mm == 0mm || A.Hole_Size_X - 0.9mm == 0mm)")
  (condition "(A.Type == 'Pad') && (A.Hole_Size_X > 0mm) && (A.Hole_Size_X < 1mm)")
  (severity error)
)
